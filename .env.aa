# AA (Application Architect) persona build overrides
# Used via: npm run build:aa  (astro build --mode aa, outputs to dist-aa/)
# Merges over the defaults in src/config.ts — only override what differs for this persona.
#
# SITE_URL is left unset until a dedicated domain is chosen; set it here once decided,
# since it drives canonical URLs, sitemap, and OG tags for this build.

SITE_PERSONA=aa
SITE_AUTHOR_TITLE="애플리케이션 아키텍트"
SITE_DESCRIPTION="공공/엔터프라이즈 프로젝트의 애플리케이션 아키텍처, 인프라 표준, CI/CD 체계를 설계하고 리딩합니다."
