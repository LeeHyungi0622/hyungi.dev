---
/**
 * Footer Component
 *
 * Site-wide footer displaying copyright information, quick contact CTAs
 * (email, GitHub, resume download), and other social media links. Responsive layout
 * that stacks vertically on mobile devices.
 *
 * Social links are pulled from siteConfig.social and only displayed if they have
 * a URL value configured. Links open in new tabs with proper security attributes.
 *
 * @component
 *
 * @example
 * ```astro
 * <Footer />
 * ```
 */
import { siteConfig } from '../config';

/**
 * Gets the current year for copyright display
 */
const currentYear = new Date().getFullYear();

/**
 * Filters and formats social links from site configuration
 *
 * Only includes platforms that have a URL configured (non-empty values).
 * GitHub has its own footer button, so it is excluded here.
 * Capitalizes platform names for display.
 *
 * @returns Array of social link objects with platform name and URL
 */
const socialLinks = Object.entries(siteConfig.social)
  .filter(([platform, url]) => url && platform !== 'github')
  .map(([platform, url]) => ({
    platform: platform.charAt(0).toUpperCase() + platform.slice(1),
    url
  }));
---

<footer class="site-footer">
  <div class="footer-container">
    <span class="copyright">© {currentYear} {siteConfig.author.name}</span>

    <div class="footer-cta">
      <a href={`mailto:${siteConfig.author.email}`} class="cta-link">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="M3 7l9 6 9-6"></path>
        </svg>
        이메일
      </a>
      {siteConfig.social.github && (
        <a href={siteConfig.social.github} class="cta-link" target="_blank" rel="noopener noreferrer">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
          </svg>
          GitHub
        </a>
      )}
      {siteConfig.resumeUrl && (
        <a href={siteConfig.resumeUrl} class="cta-link cta-link--primary" download>이력서 다운로드</a>
      )}
    </div>

    {socialLinks.length > 0 && (
      <div class="footer-social">
        {socialLinks.map((link, index) => (
          <>
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.platform}
            </a>
            {index < socialLinks.length - 1 && <span class="separator">·</span>}
          </>
        ))}
      </div>
    )}
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-width-thick) solid var(--color-border);
    padding: 2rem 1.5rem;
    margin-top: auto;
  }

  .footer-container {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .copyright {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .footer-cta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    padding: 0.4375rem 0.875rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .cta-link:hover {
    color: var(--color-text);
    box-shadow: var(--shadow-hard-sm);
    transform: translate(-1.5px, -1.5px);
  }

  .cta-link--primary {
    background: var(--color-yellow);
  }

  .footer-social {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-social a {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-social a:hover {
    color: var(--color-text);
  }

  .separator {
    color: var(--color-text-muted);
    opacity: 0.5;
    user-select: none;
  }

  @media (max-width: 640px) {
    .footer-container {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
