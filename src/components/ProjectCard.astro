---
/**
 * ProjectCard Component
 * 
 * Displays a project or case study entry in a card format with year, outcome summary,
 * and hashtags. Extends BaseCard component with project-specific features including
 * an optional featured badge and status indicator.
 * 
 * @component
 * 
 * @example
 * ```astro
 * <ProjectCard
 *   title="E-commerce Platform Redesign"
 *   slug="ecommerce-redesign"
 *   outcomeSummary="Increased conversion rate by 45% and reduced cart abandonment"
 *   role="Lead Frontend Developer"
 *   year={2024}
 *   featured={true}
 *   status="completed"
 * />
 * ```
 */

import BaseCard from './BaseCard.astro';
import ForwardLink from './ForwardLink.astro';
import ProjectTags from './ProjectTags.astro';

interface Props {
  title: string;
  slug: string;
  category: '실무' | '개인 프로젝트';
  outcomeSummary: string;
  role: string;
  year: number;
  featured?: boolean;
  status?: 'completed' | 'ongoing' | 'archived';
}

const { title, slug, category, outcomeSummary, role, year, featured = false, status = 'completed' } = Astro.props;

// Status display configuration
const statusConfig = {
  completed: { label: 'Completed', class: 'status--completed' },
  ongoing: { label: 'Ongoing', class: 'status--ongoing' },
  archived: { label: 'Archived', class: 'status--archived' },
};
const statusInfo = statusConfig[status];
---

<BaseCard href={`/projects/${slug}`} class="project-card">
  <span slot="badge" class:list={['corner-badge', category === '실무' ? 'corner-badge--work' : 'corner-badge--personal']}>
    {category}
  </span>
  <div slot="badge" class="card-badges">
    {featured && (
      <span class="featured-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        Featured
      </span>
    )}
    {status !== 'completed' && (
      <span class:list={['status-badge', statusInfo.class]}>
        {statusInfo.label}
      </span>
    )}
  </div>
  
  <Fragment slot="meta">{year}</Fragment>
  <Fragment slot="title">{title}</Fragment>
  <Fragment slot="description">{outcomeSummary}</Fragment>
  
  <div slot="tags" class="tags-list">
    <ProjectTags role={role} slug={slug} />
  </div>
  
  <ForwardLink text="View case study" />
</BaseCard>

<style>
  .corner-badge {
    position: absolute;
    top: -0.6rem;
    left: 1.25rem;
    display: inline-flex;
    align-items: center;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 0.3rem 0.75rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--border-radius-sm);
    box-shadow: var(--shadow-hard-sm);
    z-index: 1;
  }

  .corner-badge--work {
    background: var(--color-accent);
    color: #ffffff;
  }

  .corner-badge--personal {
    background: var(--color-yellow);
    color: var(--color-text);
  }

  .card-badges {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .card-badges:empty {
    display: none;
  }

  .featured-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
    background: var(--color-yellow);
    border: 1.5px solid var(--color-border);
    border-radius: var(--border-radius-sm);
    padding: 0.25rem 0.5rem;
  }

  .featured-badge svg {
    flex-shrink: 0;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.625rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--border-radius-sm);
  }

  .status--ongoing {
    background: #d5f5e3;
    color: #0f7938;
  }

  .status--archived {
    background: var(--color-bg-secondary);
    color: var(--color-text-muted);
  }

</style>
