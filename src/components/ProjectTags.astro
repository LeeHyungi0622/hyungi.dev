---
import { siteConfig } from '../config';
import { AA_PROJECT_TAGS } from '../lib/aaPersona';

interface Props {
  role: string;
  slug: string;
}

const { role, slug } = Astro.props;
const roles = role.split(/,|&/).map((r) => r.trim()).filter(Boolean);
const jdTags = siteConfig.persona === 'aa' ? AA_PROJECT_TAGS[slug] ?? [] : [];
---

<div class="project-tags">
  {roles.map((r) => <span class="hash-tag">#{r}</span>)}
  {jdTags.map((tag) => (
    <span class:list={['hash-tag', 'hash-tag--jd', { 'hash-tag--required': tag.kind === 'required' }]}>#{tag.label}</span>
  ))}
</div>

<style>
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.125rem 0.625rem;
    width: 100%;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .hash-tag {
    white-space: nowrap;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .hash-tag--jd {
    font-weight: 700;
    color: var(--color-text);
  }

  .hash-tag--required {
    padding: 0 0.2rem;
    background: var(--color-yellow);
    color: #111111;
  }
</style>
