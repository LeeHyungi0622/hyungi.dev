---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: '홈', href: '/' },
  { label: '프로젝트', href: '/projects' },
  { label: '의사결정', href: '/decisions' },
  { label: '글', href: '/writing' },
  { label: '여정', href: '/journey' },
  { label: '도구', href: '/uses' },
  { label: '연락처', href: '/contact' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="nav-scroll">
    <ul class="nav-list">
      {navItems.map((item) => (
        <li class="nav-item">
          <a
            href={item.href}
            class:list={['nav-link', { 'nav-link--active': isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  function updateNav() {
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
    navLinks.forEach((link) => {
      const path = new URL(link.href).pathname;
      const active = path === '/' ? currentPath === '/' : currentPath.startsWith(path);
      link.classList.toggle('nav-link--active', active);
      if (active) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  document.addEventListener('astro:page-load', updateNav);
</script>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: var(--color-bg);
    border-bottom: var(--border-width-thick) solid var(--color-border);
    padding: 0.875rem var(--space-lg);
  }

  .nav-scroll {
    flex: 1;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .nav-scroll::-webkit-scrollbar { display: none; }

  .nav-list {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0.125rem;
    min-width: max-content;
  }

  .nav-item {
    margin: 0;
    flex-shrink: 0;
  }

  .nav-link {
    display: inline-block;
    color: var(--color-text);
    font-size: 0.8125rem;
    font-weight: 700;
    padding: 0.5rem 0.875rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    background: var(--color-bg-secondary);
    color: var(--color-text);
  }

  .nav-link--active {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .nav-link--active:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  @media (max-width: 768px) {
    .site-nav {
      gap: 1rem;
      padding: 0.75rem 1rem;
    }

    .nav-link {
      font-size: 0.75rem;
      padding: 0.4375rem 0.75rem;
    }
  }
</style>
