---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import ForwardLink from '../components/ForwardLink.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';
import { t } from '../i18n';
import { AA_PROJECT_ORDER } from '../lib/aaPersona';

const allProjects = await getCollection('projects');
const featuredProjects = siteConfig.persona === 'aa'
  ? allProjects
      .filter((p) => p.data.category === '실무')
      .sort((a, b) => AA_PROJECT_ORDER.indexOf(a.id) - AA_PROJECT_ORDER.indexOf(b.id))
  : allProjects
      .filter(p => p.data.featured === true)
      .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))
      .slice(0, 6);

function splitRole(role: string): string[] {
  return role.split(/,|&/).map((r) => r.trim()).filter(Boolean);
}

const allDecisions = await getCollection('decisions');
const recentDecisions = allDecisions
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 2);

const allJourney = await getCollection('journey');
const recentJourney = allJourney
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 2);
---

<BaseLayout>
  <SEO
    slot="head"
    title={`${siteConfig.author.name} - ${siteConfig.author.title}`}
    description={siteConfig.description}
    type="website"
    noSuffix
  />

  <StructuredData type="WebSite" />
  <StructuredData type="Person" />

  <main class="home-page">
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-left">
          <div class="hero-sub">
            <span class="hero-lead" set:html={t('hero.sub1')} /><br/><br/>
            <span class="hero-sub">{t('hero.sub2')}</span><br/><br/>
          </div>
          <p class="hero-meta">
            {t('hero.intro1').replace('{name}', siteConfig.author.name).replace('{title}', siteConfig.author.title)}
          </p>
          <div class="hero-intro">
            <p set:html={t('hero.intro2')} />
            {siteConfig.persona !== 'aa' && (
              <ForwardLink href="/journey" text={t('hero.journey')} variant="muted" />
            )}
          </div>
        </div>

        <div class="hero-right">
          <div class="section-header">
            <h2><span class="highlight-sweep">{t('hero.section')}</span></h2>
            <ForwardLink href="/projects" text={t('section.viewAll')} variant="muted" />
          </div>
          <div class="case-snapshots">
            {featuredProjects.map((project) => (
              <a href={`/projects/${project.id}`} class="case-snapshot">
                <span class:list={['corner-badge', project.data.category === '실무' ? 'corner-badge--work' : 'corner-badge--personal']}>
                  {project.data.category}
                </span>
                <span class="case-title">{project.data.title}</span>
                <span class="case-outcome">{project.data.outcomeSummary}</span>
                <div class="case-tags">
                  {splitRole(project.data.role).map((r) => (
                    <span class="case-tag">{r}</span>
                  ))}
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <div class:list={['two-col-sections', { 'two-col-sections--single': siteConfig.persona === 'aa' }]}>
      <section class="recent-decisions">
        <div class="section-header">
          <h2>{t('section.recentDecisions')}</h2>
          <ForwardLink href="/decisions" text={t('section.viewAll')} variant="muted" />
        </div>

        {recentDecisions.length > 0 ? (
          <div class="decisions-list">
            {recentDecisions.map((decision) => {
              const date = new Date(decision.data.date);
              const formattedDate = date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
              return (
                <a href={`/decisions/${decision.id}`} class="decision-item">
                  <span class="decision-date">{formattedDate}</span>
                  <h3 class="decision-title">{decision.data.title}</h3>
                  <p class="decision-context">{decision.data.context}</p>
                </a>
              );
            })}
          </div>
        ) : (
          <p class="no-decisions">{t('decisions.empty')}</p>
        )}
      </section>

      {siteConfig.persona !== 'aa' && (
        <section class="recent-journey">
          <div class="section-header">
            <h2>{t('journey.heading')}</h2>
            <ForwardLink href="/journey" text={t('section.viewAll')} variant="muted" />
          </div>

          {recentJourney.length > 0 ? (
            <div class="decisions-list">
              {recentJourney.map((entry) => {
                const date = new Date(entry.data.date);
                const formattedDate = date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
                return (
                  <a href="/journey" class="decision-item">
                    <span class="decision-date">{formattedDate}</span>
                    <h3 class="decision-title">{entry.data.title}</h3>
                    <p class="decision-context">{entry.data.description}</p>
                  </a>
                );
              })}
            </div>
          ) : (
            <p class="no-decisions">{t('journey.empty')}</p>
          )}
        </section>
      )}
    </div>
  </main>

  <style>
    .home-page {
      max-width: 1700px;
      margin: 0 auto;
      padding: 0 4rem 2rem;
    }

    .hero {
      padding: 2rem 0 2rem;
      border-bottom: var(--border-width-thick) solid var(--color-border);
      margin-bottom: 2rem;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 0.85fr 1.15fr;
      gap: 2.5rem;
      align-items: start;
    }

    .hero-left {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1.25rem;
      height: 100%;
      padding-right: 1rem;
    }

    .hero-sub {
      font-size: 1.125rem;
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    .hero-lead {
      font-size: 1.625rem;
      font-weight: var(--font-weight-bold);
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    .hero-sub-em {
      font-size: 1.25rem;
      font-weight: 900;
      color: var(--color-text)
    }

    .hero-meta {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      letter-spacing: 0.01em;
    }

    .hero-right {
      padding-top: 0.5rem;
    }

    .case-snapshots {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .case-snapshot {
      position: relative;
      display: flex;
      flex-direction: column;
      height: 100%;
      padding: 1.25rem 1.5rem;
      background: var(--color-bg);
      border: var(--border-width) solid var(--color-border);
      border-radius: var(--border-radius-md);
      box-shadow: var(--shadow-hard-sm);
      text-decoration: none;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .case-snapshot:hover {
      background: var(--color-yellow);
      box-shadow: var(--shadow-hard-md);
      transform: translate(-2px, -2px);
    }

    .corner-badge {
      position: absolute;
      top: -0.6rem;
      left: 1.25rem;
      display: inline-flex;
      align-items: center;
      font-size: 0.6875rem;
      font-weight: 800;
      letter-spacing: 0.02em;
      padding: 0.3rem 0.75rem;
      border: var(--border-width) solid var(--color-border);
      border-radius: var(--border-radius-sm);
      box-shadow: var(--shadow-hard-sm);
      z-index: 1;
    }

    .corner-badge--work {
      background: var(--color-accent);
      color: #ffffff;
    }

    .corner-badge--personal {
      background: var(--color-yellow);
      color: var(--color-text);
    }

    .case-title {
      display: block;
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-text);
      margin-top: 0.5rem;
      margin-bottom: 0.5rem;
      line-height: 1.4;
    }

    .case-outcome {
      display: block;
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    .case-tags {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.375rem;
      margin-top: auto;
      padding-top: 0.875rem;
    }

    .case-tag {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.15rem 0.5rem;
      border: 1.5px solid var(--color-border);
      border-radius: var(--border-radius-sm);
      color: var(--color-text);
      background: var(--color-bg);
    }

    .hero-intro {
      font-size: 1.125rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
    }

    .hero-intro p {
      margin-bottom: 1rem;
    }

    .hero-intro p:first-child {
      color: var(--color-text);
    }

    .hero-intro :global(.highlight-sweep) {
      font-weight: 700;
      color: var(--color-text);
    }

    .two-col-sections {
      display: grid;
      grid-template-columns: 0.85fr 1.15fr;
      gap: 2.5rem;
    }

    .two-col-sections--single {
      grid-template-columns: 1fr;
    }

    .section-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 2rem;
    }

    .section-header h2 {
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    :global(.highlight-sweep) {
      position: relative;
      display: inline-block;
    }

    :global(.highlight-sweep::before) {
      content: '';
      position: absolute;
      left: 0;
      right: 100%;
      bottom: 0.05em;
      top: 0.1em;
      background: var(--color-yellow);
      z-index: -1;
      border-radius: 2px;
      animation: highlight-sweep 0.7s cubic-bezier(0.65, 0, 0.35, 1) 0.2s forwards;
    }

    @keyframes highlight-sweep {
      to {
        right: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      :global(.highlight-sweep::before) {
        animation: none;
        right: 0;
      }
    }

    .decisions-list {
      display: flex;
      flex-direction: column;
      gap: 0;
      border-top: 1.5px solid var(--color-border-subtle);
    }

    .decision-item {
      display: block;
      padding: 1.5rem 0;
      border-bottom: 1.5px solid var(--color-border-subtle);
      text-decoration: none;
      transition: background 0.15s ease, box-shadow 0.15s ease;
    }

    .decision-item:last-child {
      border-bottom: none;
    }

    .decision-item:hover {
      background: var(--color-yellow);
      box-shadow: 1rem 0 0 var(--color-yellow), -1rem 0 0 var(--color-yellow);
    }

    .decision-item:hover .decision-title {
      text-decoration: underline;
      text-decoration-thickness: 2px;
    }

    .decision-date {
      display: block;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-muted);
      margin-bottom: 0.5rem;
    }

    .decision-title {
      font-size: 1.125rem;
      font-weight: 600;
      line-height: 1.3;
      color: var(--color-text);
      margin-bottom: 0.5rem;
    }

    .decision-context {
      font-size: 0.9375rem;
      line-height: 1.6;
      color: var(--color-text-secondary);
    }

    .no-decisions {
      color: var(--color-text-muted);
      font-style: italic;
      padding: 1.5rem 0;
    }

    .recent-journey {
      margin-bottom: 5rem;
    }

    @media (max-width: 768px) {
      .home-page { padding: 0 1rem 3rem; }
      .hero { padding: 2.5rem 0 3rem; }
      .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .hero-left { padding-right: 0; }
      .case-snapshots { grid-template-columns: 1fr; }
      .hero-intro { font-size: 1rem; }
      .two-col-sections { grid-template-columns: 1fr; gap: 3rem; }
      .section-header { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
      .decision-title { font-size: 1rem; }
    }
  </style>
</BaseLayout>
