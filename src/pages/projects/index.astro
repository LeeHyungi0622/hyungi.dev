---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PageStats from '../../components/PageStats.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n';

const allProjects = await getCollection('projects');

// 실무 + Featured 프로젝트를 최우선으로 선배치
function priorityRank(p: (typeof allProjects)[number]): number {
  return p.data.category === '실무' && p.data.featured ? 0 : 1;
}

const sortedProjects = allProjects
  .sort((a, b) => {
    const rankDiff = priorityRank(a) - priorityRank(b);
    if (rankDiff !== 0) return rankDiff;
    if (a.data.order !== undefined && b.data.order !== undefined) return a.data.order - b.data.order;
    if (a.data.order !== undefined) return -1;
    if (b.data.order !== undefined) return 1;
    return b.data.year - a.data.year;
  });

const totalProjects = sortedProjects.length;
const featuredCount = sortedProjects.filter(p => p.data.featured).length;
---

<BaseLayout>
  <SEO
    slot="head"
    title={`${t('projects.heading')} | ${import.meta.env.SITE_AUTHOR_NAME || 'Portfolio'}`}
    description={t('projects.intro')}
    type="website"
  />

  <main class="page-container">
    <header class="page-header">
      <h1 class="page-title">{t('projects.heading')}</h1>
      <p class="page-intro">{t('projects.intro')}</p>
      <PageStats text={`${totalProjects} projects · ${featuredCount} featured`} />
    </header>

    {sortedProjects.length > 0 ? (
      <div class="card-list">
        {sortedProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            slug={project.id}
            category={project.data.category}
            outcomeSummary={project.data.outcomeSummary}
            role={project.data.role}
            year={project.data.year}
            techStack={project.data.techStack}
            featured={project.data.featured}
            status={project.data.status}
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">{t('projects.empty')}</p>
    )}
  </main>
</BaseLayout>
