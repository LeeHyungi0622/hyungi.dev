---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PageStats from '../../components/PageStats.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n';
import { siteConfig } from '../../config';
import { compareLatestProjects, formatProjectYears } from '../../lib/projectYears';

const allProjects = await getCollection('projects');

// 실무 + Featured 프로젝트를 최우선으로 선배치
function priorityRank(p: (typeof allProjects)[number]): number {
  return p.data.category === '실무' && p.data.featured ? 0 : 1;
}

const sortedProjects = siteConfig.persona === 'aa'
  ? allProjects.filter((p) => p.data.category === '실무').sort(compareLatestProjects)
  : allProjects.sort((a, b) => priorityRank(a) - priorityRank(b) || compareLatestProjects(a, b));

const intro = t(siteConfig.persona === 'aa' ? 'projects.introAa' : 'projects.intro');

const totalProjects = sortedProjects.length;
---

<BaseLayout>
  <SEO
    slot="head"
    title={`${t('projects.heading')} | ${import.meta.env.SITE_AUTHOR_NAME || 'Portfolio'}`}
    description={intro}
    type="website"
  />

  <main class="page-container">
    <header class="page-header">
      <h1 class="page-title">{t('projects.heading')}</h1>
      <p class="page-intro">{intro}</p>
      <PageStats text={`${totalProjects} projects`} />
    </header>

    {sortedProjects.length > 0 ? (
      <div class="card-list">
        {sortedProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            slug={project.id}
            category={project.data.category}
            outcomeSummary={project.data.outcomeSummary}
            role={project.data.role}
            years={formatProjectYears(project.data)}
            status={project.data.status}
          />
        ))}
      </div>
    ) : (
      <p class="empty-state">{t('projects.empty')}</p>
    )}
  </main>
</BaseLayout>
