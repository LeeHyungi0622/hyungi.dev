---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import StructuredData from '../../components/StructuredData.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import BackLink from '../../components/BackLink.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ImpactMetrics from '../../components/ImpactMetrics.astro';
import RichText from '../../components/RichText.astro';
import { getCollection, render } from 'astro:content';
import { calculateReadingTime, formatReadingTime } from '../../utils/readingTime';
import { t } from '../../i18n';
import { siteConfig } from '../../config';
import { formatProjectYears } from '../../lib/projectYears';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;

const { Content } = await render(project);

const {
  title, category, role, year, duration, teamSize, outcomeSummary,
  overview, repository, architectureImage, extraArchitectureImages = [], architecturePending, deploymentGuide, problem, constraints, approach,
  keyDecisions, techStack, impact, learnings,
  relatedProjects, relatedDecisions, status,
} = project.data;

const statusLabels = {
  completed: t('status.completed'),
  ongoing: t('status.ongoing'),
  archived: t('status.archived'),
};

const statusConfig = {
  completed: { label: statusLabels.completed, class: 'status--completed' },
  ongoing: { label: statusLabels.ongoing, class: 'status--ongoing' },
  archived: { label: statusLabels.archived, class: 'status--archived' },
};
const statusInfo = statusConfig[status || 'completed'];

const allText = [
  overview, problem, approach,
  ...constraints,
  ...keyDecisions.map(d => `${d.decision} ${d.reasoning} ${d.alternatives?.join(' ') || ''}`),
  impact.qualitative,
  ...learnings,
  project.body || '',
].join(' ');
const readingTime = formatReadingTime(calculateReadingTime(allText));

const teamSizeText = teamSize
  ? (teamSize === 1 ? t('common.person').replace('{n}', '1') : t('common.people').replace('{n}', String(teamSize)))
  : null;
---

<BaseLayout>
  <SEO
    slot="head"
    title={`${title} - ${t('meta.caseStudy')}`}
    description={outcomeSummary}
    type="article"
  />

  <StructuredData
    type="Project"
    data={{ title, outcomeSummary, problem, impact: impact.qualitative, techStack, year }}
  />

  <main class="case-study">
    <header class="case-study-header">
      <div class="header-badges">
        {siteConfig.persona !== 'aa' && (
          <span class:list={['category-badge', category === '실무' ? 'category-badge--work' : 'category-badge--personal']}>
            {category}
          </span>
        )}
        {status && status !== 'completed' && (
          <span class:list={['status-badge', statusInfo.class]}>
            {statusInfo.label}
          </span>
        )}
      </div>
      <h1>{title}</h1>
      <div class="case-study-meta">
        <span class="meta-item">{role}</span>
        <span class="meta-separator">·</span>
        <span class="meta-item">{formatProjectYears(project.data)}</span>
        {duration && (
          <>
            <span class="meta-separator">·</span>
            <span class="meta-item">{duration}</span>
          </>
        )}
        {teamSize && (
          <>
            <span class="meta-separator">·</span>
            <span class="meta-item">{teamSizeText}</span>
          </>
        )}
        <span class="meta-separator">·</span>
        <span class="meta-item">{t('common.readingTime').replace('{time}', readingTime)}</span>
        {repository && (
          <>
            <span class="meta-separator">·</span>
            <a class="meta-item meta-link" href={repository} target="_blank" rel="noopener noreferrer">GitHub 저장소</a>
          </>
        )}
      </div>
      <p class="outcome-summary">{outcomeSummary}</p>
    </header>

    <div class="case-study-body">
      <div class="case-study-main">
        <section class="case-study-section">
          <h2>{t('case.overview')}</h2>
          <RichText text={overview} />
        </section>

        {(architectureImage || architecturePending) && (
          <section class="case-study-section">
            <h2>{t('case.architecture')}</h2>
            {architectureImage ? (
              [architectureImage, ...extraArchitectureImages].map((image) => (
                <figure class="architecture-figure">
                  <div class="architecture-image-wrapper" data-architecture-trigger tabindex="0" role="button" aria-label={`${image.alt} 클릭하여 확대 보기`}>
                    <img
                      src={image.src}
                      alt={image.alt}
                      class="architecture-image"
                      loading="lazy"
                    />
                    <span class="zoom-hint" aria-hidden="true">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="11" cy="11" r="7"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        <line x1="11" y1="8" x2="11" y2="14"></line>
                        <line x1="8" y1="11" x2="14" y2="11"></line>
                      </svg>
                      클릭하여 확대
                    </span>
                  </div>
                  <figcaption>{image.alt}</figcaption>
                </figure>
              ))
            ) : (
              <div class="architecture-pending">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                  <circle cx="8.5" cy="8.5" r="1.5"></circle>
                  <path d="M21 15l-5-5L5 21"></path>
                </svg>
                <p>구성도 업데이트 예정입니다.</p>
              </div>
            )}
          </section>
        )}

        {deploymentGuide && (
          <section class="case-study-section">
            <h2>{t('case.deploymentArtifacts')}</h2>
            <div class="pdf-viewer-wrapper">
              <div class="pdf-viewer-toolbar">
                <span class="pdf-viewer-title">{deploymentGuide.title}</span>
                <a href={deploymentGuide.src} target="_blank" rel="noopener" class="pdf-viewer-link">새 탭에서 열기 ↗</a>
              </div>
              <iframe
                src={deploymentGuide.src}
                class="pdf-viewer-frame"
                title={deploymentGuide.title}
                loading="lazy"
              ></iframe>
            </div>
            <p class="pdf-viewer-note">직접 작성한 배포 가이드 문서 전문입니다. 소속 정보 등 민감 항목은 가림 처리했습니다.</p>
          </section>
        )}

        <section class="case-study-section">
          <h2>{t('case.constraints')}</h2>
          <ul class="constraints-list">
            {constraints.map((c) => <li>{c}</li>)}
          </ul>
        </section>

        <section class="case-study-section">
          <h2>{t('case.techStack')}</h2>
          <ul class="tech-stack-list">
            {techStack.map((tech) => <li>{tech}</li>)}
          </ul>
        </section>

        <section class="case-study-section">
          <h2>{t('case.learnings')}</h2>
          <ul class="learnings-list">
            {learnings.map((l) => <li>{l}</li>)}
          </ul>
        </section>

        {Content && (
          <section class="case-study-content">
            <Content />
          </section>
        )}
      </div>

      <div class="case-study-sidebar">
        <section class="case-study-section">
          <h2>{t('case.problem')}</h2>
          <RichText text={problem} />
        </section>

        <section class="case-study-section">
          <h2>{t('case.approach')}</h2>
          <RichText text={approach} />
        </section>

        <section class="case-study-section">
          <h2>{t('case.keyDecisions')}</h2>
          <div class="decisions-list">
            {keyDecisions.map((decision, i) => (
              <details class="decision-item" open={i === 0}>
                <summary class="decision-title">{decision.decision}</summary>
                <div class="decision-body">
                  <div class="decision-reasoning">
                    <strong>{t('case.reasoning')}</strong>
                    <p>{decision.reasoning}</p>
                  </div>
                  {decision.alternatives && decision.alternatives.length > 0 && (
                    <div class="decision-alternatives">
                      <strong>{t('case.alternatives')}</strong>
                      <ul>
                        {decision.alternatives.map((alt) => <li>{alt}</li>)}
                      </ul>
                    </div>
                  )}
                </div>
              </details>
            ))}
          </div>
        </section>

        <section class="case-study-section">
          <h2>{t('case.impact')}</h2>
          {impact.metrics && impact.metrics.length > 0 && (
            <ImpactMetrics metrics={impact.metrics} />
          )}
          <p class="impact-qualitative">{impact.qualitative}</p>
        </section>

        <RelatedContent
          relatedProjects={relatedProjects}
          relatedDecisions={relatedDecisions}
        />

        <BackLink href="/projects" text={t('meta.allProjects')} />
      </div>
    </div>
  </main>

  {architectureImage && (
    <dialog class="image-lightbox" id="architecture-lightbox">
      <div class="lightbox-toolbar">
        <button type="button" class="lightbox-btn" data-zoom-out aria-label="축소">−</button>
        <span class="lightbox-zoom-level" data-zoom-level>100%</span>
        <button type="button" class="lightbox-btn" data-zoom-in aria-label="확대">+</button>
        <button type="button" class="lightbox-btn" data-zoom-reset aria-label="원본 크기로">Reset</button>
        <button type="button" class="lightbox-btn lightbox-close" data-lightbox-close aria-label="닫기">✕</button>
      </div>
      <div class="lightbox-viewport" data-lightbox-viewport>
        <img class="lightbox-image" data-lightbox-image src="" alt="" draggable="false" />
      </div>
    </dialog>
  )}

  <ScrollToTop />

  <style>
    .case-study {
      max-width: 1700px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    .case-study-body {
      display: grid;
      grid-template-columns: 3fr 2fr;
      gap: 4rem;
      align-items: start;
    }

    .case-study-sidebar {
      position: sticky;
      top: 5rem;
    }

    .case-study-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: var(--border-width-thick) solid var(--color-border);
    }

    .header-badges { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; }

    .category-badge {
      display: inline-flex;
      align-items: center;
      font-size: 0.6875rem;
      font-weight: 800;
      letter-spacing: 0.02em;
      padding: 0.3rem 0.75rem;
      border: 1.5px solid var(--color-border);
      border-radius: var(--border-radius-sm);
      box-shadow: var(--shadow-hard-sm);
    }

    .category-badge--work {
      background: var(--color-accent);
      color: #ffffff;
    }

    .category-badge--personal {
      background: var(--color-yellow);
      color: var(--color-text);
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      font-size: 0.6875rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.3rem 0.625rem;
      border: 1.5px solid var(--color-border);
      border-radius: var(--border-radius-sm);
    }

    .status--ongoing { background: #d5f5e3; color: #0f7938; }
    .status--archived { background: var(--color-bg-secondary); color: var(--color-text-muted); }

    .case-study-header h1 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.2;
    }

    .case-study-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.9375rem;
      color: var(--color-text-secondary);
      margin-bottom: 1.5rem;
    }

    .meta-separator { opacity: 0.5; }
    .meta-link { color: inherit; text-decoration: underline; }

    .outcome-summary {
      font-size: 1.125rem;
      line-height: 1.6;
      color: var(--color-text-secondary);
    }

    .case-study-section { margin-bottom: 3rem; }

    .case-study-section h2 {
      font-size: 1.75rem;
      margin-bottom: 1.25rem;
      font-weight: 800;
      letter-spacing: -0.01em;
    }

    .case-study-section p {
      font-size: 1.125rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
    }

    .constraints-list, .tech-stack-list, .learnings-list {
      list-style: none;
      padding: 0;
    }

    .constraints-list li, .tech-stack-list li, .learnings-list li {
      font-size: 1.0625rem;
      line-height: 1.7;
      padding: 0.5rem 0;
      padding-left: 1.5rem;
      position: relative;
      color: var(--color-text-secondary);
    }

    .constraints-list li::before,
    .tech-stack-list li::before,
    .learnings-list li::before {
      content: "→";
      position: absolute;
      left: 0;
      color: var(--color-accent);
    }

    .decisions-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .decision-item {
      padding: 1.25rem;
      border: var(--border-width) solid var(--color-border);
      border-radius: var(--border-radius-md);
      box-shadow: var(--shadow-hard-sm);
      background: var(--color-bg);
    }

    .decision-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      font-size: 1.0625rem;
      font-weight: 800;
      color: var(--color-text);
      cursor: pointer;
      list-style: none;
      user-select: none;
    }

    .decision-title::-webkit-details-marker { display: none; }

    .decision-title::after {
      content: "";
      flex-shrink: 0;
      width: 0.5rem;
      height: 0.5rem;
      border-right: 2px solid var(--color-text-muted);
      border-bottom: 2px solid var(--color-text-muted);
      transform: rotate(45deg);
      transition: transform 0.15s ease;
      margin-top: -0.2rem;
    }

    .decision-item[open] .decision-title::after {
      transform: rotate(-135deg);
      margin-top: 0.2rem;
    }

    .decision-item:not([open]) .decision-title:hover {
      color: var(--color-accent);
    }

    .decision-body { margin-top: 0.75rem; }

    .decision-reasoning, .decision-alternatives { margin-top: 0.75rem; }

    .decision-reasoning strong, .decision-alternatives strong {
      display: block;
      font-size: 0.9375rem;
      color: var(--color-text-muted);
      margin-bottom: 0.5rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .decision-reasoning p {
      font-size: 0.9375rem;
      line-height: 1.55;
      margin-top: 0.5rem;
      color: var(--color-text-secondary);
    }

    .decision-alternatives ul {
      list-style: none;
      padding: 0;
      margin-top: 0.5rem;
    }

    .decision-alternatives li {
      font-size: 0.9375rem;
      line-height: 1.5;
      padding: 0.25rem 0;
      padding-left: 1.25rem;
      position: relative;
      color: var(--color-text-secondary);
    }

    .decision-alternatives li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: var(--color-accent);
    }

    .architecture-figure { margin: 2rem 0 0; padding: 0; }

    .pdf-viewer-wrapper {
      border: var(--border-width) solid var(--color-border);
      border-radius: var(--border-radius-md);
      box-shadow: var(--shadow-hard-sm);
      overflow: hidden;
      background: var(--color-bg);
    }

    .pdf-viewer-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.75rem 1rem;
      border-bottom: var(--border-width) solid var(--color-border);
    }

    .pdf-viewer-title {
      font-weight: 700;
      font-size: 0.9375rem;
    }

    .pdf-viewer-link {
      font-size: 0.875rem;
      font-weight: 700;
      color: var(--color-text);
      text-decoration: none;
      white-space: nowrap;
    }

    .pdf-viewer-link:hover {
      text-decoration: underline;
    }

    .pdf-viewer-frame {
      width: 100%;
      height: 800px;
      border: none;
      display: block;
    }

    .pdf-viewer-note {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      margin-top: 0.75rem;
    }

    .architecture-image-wrapper {
      position: relative;
      cursor: zoom-in;
      overflow: hidden;
      border-radius: var(--border-radius-md);
    }

    .architecture-image-wrapper:focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }

    .architecture-image {
      width: 100%;
      border-radius: var(--border-radius-md);
      border: var(--border-width) solid var(--color-border);
      display: block;
      transition: transform 0.25s ease;
    }

    .architecture-image-wrapper:hover .architecture-image,
    .architecture-image-wrapper:focus-visible .architecture-image {
      transform: scale(1.015);
    }

    .zoom-hint {
      position: absolute;
      bottom: 0.75rem;
      right: 0.75rem;
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.35rem 0.7rem;
      background: var(--color-bg);
      border: 1.5px solid var(--color-border);
      border-radius: var(--border-radius-sm);
      box-shadow: var(--shadow-hard-sm);
      pointer-events: none;
    }

    .architecture-figure figcaption {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      text-align: center;
      margin-top: 0.75rem;
    }

    .architecture-pending {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      padding: 3rem 1.5rem;
      border: var(--border-width) dashed var(--color-border-subtle);
      border-radius: var(--border-radius-md);
      color: var(--color-text-muted);
    }

    .architecture-pending p {
      font-size: 0.9375rem;
      font-weight: 600;
    }

    .image-lightbox {
      padding: 0;
      border: none;
      margin: 0;
      border-radius: var(--border-radius-lg);
      width: min(92vw, 1400px);
      height: 90vh;
      max-width: 92vw;
      max-height: 90vh;
      background: var(--color-bg);
      box-shadow: var(--shadow-hard-lg);
    }

    .image-lightbox[open] {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .image-lightbox::backdrop {
      background: rgba(17, 17, 17, 0.6);
    }

    .lightbox-toolbar {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1rem;
      border-bottom: var(--border-width) solid var(--color-border);
      flex-shrink: 0;
    }

    .lightbox-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2rem;
      height: 2rem;
      padding: 0 0.6rem;
      font-weight: 800;
      font-size: 1rem;
      background: var(--color-bg);
      border: 1.5px solid var(--color-border);
      border-radius: var(--border-radius-sm);
      cursor: pointer;
      transition: background 0.1s ease;
    }

    .lightbox-btn:hover {
      background: var(--color-yellow);
    }

    .lightbox-zoom-level {
      font-size: 0.8125rem;
      font-weight: 700;
      color: var(--color-text-muted);
      min-width: 3.5rem;
      text-align: center;
    }

    .lightbox-close {
      margin-left: auto;
    }

    .lightbox-viewport {
      flex: 1;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: grab;
      background: var(--color-bg-secondary);
    }

    .lightbox-viewport.is-dragging {
      cursor: grabbing;
    }

    .lightbox-image {
      max-width: 100%;
      max-height: 100%;
      user-select: none;
      will-change: transform;
    }

    @media (max-width: 768px) {
      .image-lightbox { width: 96vw; height: 92vh; }
    }

    .impact-qualitative {
      font-size: 1.125rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
    }

    .case-study-content {
      margin-top: 3rem;
      font-size: 1.0625rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
    }

    @media (max-width: 1024px) {
      .case-study-body { grid-template-columns: 1fr; }
      .case-study-sidebar { position: static; }
    }

    @media (max-width: 768px) {
      .case-study { padding: 1.5rem 1rem; }
      .case-study-header h1 { font-size: 2rem; }
      .case-study-section h2 { font-size: 1.5rem; }
      .case-study-section p { font-size: 1rem; }
      .decision-item { padding: 1.25rem; }
      .pdf-viewer-frame { height: 500px; }
    }
  </style>

  <script>
    function initArchitectureLightbox() {
    const dialog = document.getElementById('architecture-lightbox') as HTMLDialogElement | null;

    if (dialog) {
      const viewport = dialog.querySelector<HTMLDivElement>('[data-lightbox-viewport]')!;
      const image = dialog.querySelector<HTMLImageElement>('[data-lightbox-image]')!;
      const zoomLevelEl = dialog.querySelector<HTMLSpanElement>('[data-zoom-level]')!;
      const zoomInBtn = dialog.querySelector<HTMLButtonElement>('[data-zoom-in]')!;
      const zoomOutBtn = dialog.querySelector<HTMLButtonElement>('[data-zoom-out]')!;
      const zoomResetBtn = dialog.querySelector<HTMLButtonElement>('[data-zoom-reset]')!;
      const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]')!;

      const MIN_SCALE = 1;
      const MAX_SCALE = 4;
      const STEP = 0.4;

      let scale = 1;
      let panX = 0;
      let panY = 0;
      let isDragging = false;
      let dragStartX = 0;
      let dragStartY = 0;
      let panStartX = 0;
      let panStartY = 0;

      function applyTransform() {
        image.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
        zoomLevelEl.textContent = `${Math.round(scale * 100)}%`;
        viewport.classList.toggle('is-zoomed', scale > MIN_SCALE);
      }

      function setScale(next: number) {
        scale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, next));
        if (scale === MIN_SCALE) {
          panX = 0;
          panY = 0;
        }
        applyTransform();
      }

      function openLightbox(src: string, alt: string) {
        if (dialog!.open) return;
        image.src = src;
        image.alt = alt;
        scale = 1;
        panX = 0;
        panY = 0;
        applyTransform();
        dialog!.showModal();
        document.body.style.overflow = 'hidden';
      }

      document.querySelectorAll<HTMLElement>('[data-architecture-trigger]').forEach((wrapper) => {
        const img = wrapper.querySelector('img');
        if (!img) return;
        const trigger = () => openLightbox(img.currentSrc || img.src, img.alt);
        wrapper.addEventListener('click', trigger);
        wrapper.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            trigger();
          }
        });
      });

      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });

      dialog.addEventListener('close', () => {
        document.body.style.overflow = '';
      });

      closeBtn.addEventListener('click', () => dialog.close());
      zoomInBtn.addEventListener('click', () => setScale(scale + STEP));
      zoomOutBtn.addEventListener('click', () => setScale(scale - STEP));
      zoomResetBtn.addEventListener('click', () => setScale(1));

      viewport.addEventListener('wheel', (e) => {
        e.preventDefault();
        setScale(scale + (e.deltaY < 0 ? STEP : -STEP));
      }, { passive: false });

      viewport.addEventListener('mousedown', (e) => {
        if (scale <= MIN_SCALE) return;
        isDragging = true;
        dragStartX = e.clientX;
        dragStartY = e.clientY;
        panStartX = panX;
        panStartY = panY;
        viewport.classList.add('is-dragging');
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        panX = panStartX + (e.clientX - dragStartX);
        panY = panStartY + (e.clientY - dragStartY);
        applyTransform();
      });

      window.addEventListener('mouseup', () => {
        isDragging = false;
        viewport.classList.remove('is-dragging');
      });
    }
    }

    document.addEventListener('astro:page-load', initArchitectureLightbox);
  </script>
</BaseLayout>
