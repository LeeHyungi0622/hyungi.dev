---
/**
 * 404 Not Found Page
 *
 * Custom error page displayed when a requested page doesn't exist.
 * Features a minimal, centered layout with an icon, message, and
 * navigation back to the homepage.
 *
 * Design:
 * - No header, navigation, or footer for focused experience
 * - Centered content with SVG icon
 * - Clear messaging about the error
 * - Single CTA button to return home
 *
 * Route: /404 (automatically served for non-existent pages)
 *
 * @page
 */

import { siteConfig } from '../config';

const pageTitle = '404 - 페이지를 찾을 수 없습니다';
---

<!DOCTYPE html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="robots" content="noindex, nofollow" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />

    <!-- Pretendard (Korean-optimized bold display font) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" as="style" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css" />

    <!-- Inline critical styles -->
    <style>
      :root {
        --color-bg: #ffffff;
        --color-text: #111111;
        --color-text-secondary: #3f3f46;
        --color-text-muted: #71717a;
        --color-border: #111111;
        --color-accent: #ff3b3b;
        --color-yellow: #ffde59;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.5;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.5rem;
      }

      .container {
        max-width: 500px;
        width: 100%;
        text-align: center;
      }

      .icon-wrap {
        width: 80px;
        height: 80px;
        margin: 0 auto 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-yellow);
        border: 3px solid var(--color-border);
        border-radius: 50%;
        box-shadow: 5px 5px 0 var(--color-border);
      }

      .icon {
        width: 40px;
        height: 40px;
        color: var(--color-text);
      }

      .error-code {
        font-size: 1rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        margin-bottom: 1rem;
      }

      h1 {
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 1rem;
        color: var(--color-text);
      }

      .description {
        font-size: 1.125rem;
        line-height: 1.7;
        color: var(--color-text-secondary);
        margin-bottom: 2.5rem;
      }

      .home-button {
        display: inline-block;
        padding: 0.875rem 2rem;
        background: var(--color-bg);
        color: var(--color-text);
        font-weight: 800;
        font-size: 1rem;
        text-decoration: none;
        border: 2px solid var(--color-border);
        border-radius: 8px;
        box-shadow: 4px 4px 0 var(--color-border);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }

      .home-button:hover {
        transform: translate(4px, 4px);
        box-shadow: none;
      }

      @media (max-width: 640px) {
        .icon-wrap {
          width: 64px;
          height: 64px;
          margin-bottom: 1.5rem;
        }

        .icon {
          width: 32px;
          height: 32px;
        }

        .error-code {
          font-size: 0.875rem;
        }

        h1 {
          font-size: 1.5rem;
        }

        .description {
          font-size: 1rem;
          margin-bottom: 2rem;
        }

        .home-button {
          padding: 0.75rem 1.75rem;
          font-size: 0.9375rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="icon-wrap">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>

      <div class="error-code">404 Error</div>

      <h1>페이지를 찾을 수 없습니다</h1>

      <p class="description">
        찾으시는 페이지가 존재하지 않거나 이동되었습니다. 홈으로 돌아가 다시 찾아보세요.
      </p>

      <a href="/" class="home-button">홈으로 돌아가기</a>
    </div>
  </body>
</html>
